PORT=7777
# Public origin behind your HTTPS reverse proxy; leave empty for local use.
APP_URL=
# Public footer link, read at runtime. Leave empty to hide it; HTTPS URLs only.
GITHUB_URL=https://github.com/jc-tanedo/easy-check-api
# Optional production bind address; defaults to 0.0.0.0.
BIND_HOST=0.0.0.0
# Generate a random API key, at least 32 characters.
API_KEY=

# Required by Docker Compose; keep stable across app restarts/replicas.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
# Optional for plain-Node runs; Compose supplies its private Redis service URL.
# Without REDIS_URL, plain-Node runs use volatile in-memory stores.
REDIS_URL=

# Optional defaults for GET /check-balance. POST supplies these in its JSON body.
DRIVEHUB_EMAIL=
DRIVEHUB_PASSWORD=

# Required DriveHub application credentials (separate from your personal login).
DRIVEHUB_APP_USERNAME=
DRIVEHUB_APP_PASSWORD=
DRIVEHUB_CLIENT_ID=

# Assumption for timezone-less exp_at values; independent of the host timezone.
DRIVEHUB_EXPIRY_UTC_OFFSET=+08:00
