{
    "name": "easy-check-api",
    "version": "0.0.2",
    "description": "Next.js dashboard and API for DriveHub RFID balances",
    "scripts": {
        "dev": "node scripts/dev.js",
        "build": "next build --webpack",
        "postbuild": "node scripts/prepare-standalone.js",
        "start": "node --env-file-if-exists=.env scripts/start.js",
        "test": "node --import tsx --test test/*.test.mts",
        "test:e2e": "playwright test",
        "test:redis": "node --import tsx --test test/integration/*.test.mts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "next typegen && tsc --noEmit"
    },
    "engines": {
        "node": ">=22.9.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jc-tanedo/easy-check-api.git"
    },
    "author": "JC Tañedo",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/jc-tanedo/easy-check-api/issues"
    },
    "homepage": "https://github.com/jc-tanedo/easy-check-api#readme",
    "dependencies": {
        "axios": "^1.21.0",
        "cookie": "^1.1.1",
        "lodash": "^4.18.1",
        "lucide-react": "^1.62.0",
        "next": "^16.4.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "redis": "^5.12.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/lodash": "^4.17.27",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.4.3",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    }
}
